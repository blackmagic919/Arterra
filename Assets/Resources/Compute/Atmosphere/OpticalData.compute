#pragma kernel Bake
#pragma kernel CorrectRemainder
#pragma multi_compile _ NO_EDITORLIGHTING

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

#include "Assets/Resources/Compute/Atmosphere/TextureInterpHelper.hlsl"
#include "Assets/Resources/Compute/MapData/WSDensitySampler.hlsl"
#include "Assets/Resources/Compute/MapData/WSLightSampler.hlsl"
#include "Assets/Resources/Compute/Atmosphere/FrustumLightSpace.hlsl"
#include "Assets/Resources/Compute/Atmosphere/FrustumSunLuminance.hlsl"
const static float StaticLightIntensity = 0.01f;

RWStructuredBuffer<ScatterData> mapData;
RWStructuredBuffer<ScatterData> _RemainderScatter;
Texture2D<float> _CameraDepthTexture;

uint _NumOpticalDepthPoints;
uint _NumRemainderOpticalDepthPoints;

float3 IntegratedTransmittance(float3 opticalDepth) {
    // Average transmittance within a constant-extinction substep. Use its
    // Taylor expansion near zero to avoid cancellation and division by zero.
    bool3 nearZero = abs(opticalDepth) < 0.01f;
    float3 taylor = 1.0f + opticalDepth * (-0.5f + opticalDepth * (1.0f / 6.0f - opticalDepth / 24.0f));
    float3 denominator = nearZero ? 1.0f : opticalDepth;
    float3 integrated = (1.0f - exp(-opticalDepth)) / denominator;
    return nearZero ? taylor : integrated;
}

void AccumulateScatterSegment(
    float3 rayOrigin,
    float3 direction,
    float start,
    float step,
    uint sampleCount,
    float invIsoScale,
    float3 prefixExtinction,
    inout ScatterData scatter
) {
    float opticalStep = step * invIsoScale;
    for(uint i = 0u; i < sampleCount; i++) {
        float3 samplePoint = rayOrigin + direction * (start + (i + 0.5f) * step);
        OpticalInfo opticalInfo = SampleMapData(samplePoint);
        float3 extinctionStep = opticalInfo.extinctionCoeff * opticalStep;
        float3 viewTransmittance = exp(-(prefixExtinction + scatter.extinction));
        float3 segmentTransmittance = IntegratedTransmittance(extinctionStep);
        float3 sunLight = SampleFrustumSunLuminanceAtWS(samplePoint);

        uint light = SampleLightFast(samplePoint);
        float3 bakedLight = float3(light & 0x3FFu, (light >> 10) & 0x3FFu, (light >> 20) & 0x3FFu) / 1023.0f;
        float sunVisibility = 1.0f - ((light >> 30) & 0x3u) / 3.0f;
        float3 sunScatter = sunLight * sunVisibility * opticalInfo.scatterCoeffs;
        float3 bakedScatter = bakedLight * StaticLightIntensity * opticalInfo.scatterCoeffs;

        scatter.inScatteredLight += (sunScatter + bakedScatter) * viewTransmittance * segmentTransmittance * opticalStep;
        scatter.extinction += extinctionStep;
    }
}

const static uint numThreads = 8;
[numthreads(numThreads,numThreads,1)]
void Bake (uint3 id : SV_DispatchThreadID)
{
    uint viewX = id.x;
    uint viewY = id.y;

    if(viewX >= SampleTextureWidth || viewY >= SampleTextureHeight || id.z > 0)
        return;

    if(_NumInScatterPoints == 0u)
        return;

    uint sampleCount = max(_NumOpticalDepthPoints, 1u);
    float sampleDist = GetScatterStep();
    float sampleStep = sampleDist / (float)sampleCount;
    float2 size = float2(max(SampleTextureWidth - 1u, 1u), max(SampleTextureHeight - 1u, 1u));
    float3 direction = normalize(GetViewVectorWS(float2(viewX, viewY) / size));
    float invIsoScale = rcp(max((float)IsoLevel, 1.0f));
    float3 cameraPos = _WorldSpaceCameraPos;

    ScatterData cumulative = (ScatterData)0;

    for(uint depth = 0u; depth < _NumInScatterPoints; depth++) {
        // Layer depth is the start of the next segment, so it stores only completed segments.
        mapData[GetTextureIndex(id.xy, depth)] = cumulative;
        if(depth == _NumInScatterPoints - 1u)
            break;

        AccumulateScatterSegment(cameraPos, direction, sampleDist * depth, sampleStep,
            sampleCount, invIsoScale, 0.0f, cumulative);
    }
}

[numthreads(numThreads,numThreads,1)]
void CorrectRemainder(uint3 id : SV_DispatchThreadID) {
    if(any(id.xy >= (uint2)_AtmospherePixelSize.xy))
        return;

    uint index = GetRemainderIndex(id.xy);
    float2 uv = GetAtmospherePixelUV(id.xy);
    float3 viewVector = GetViewVectorWS(uv);
    float rayLength = GetAtmosphereRayLength(_CameraDepthTexture.Load(int3(id.xy, 0)), viewVector);
    float sampleDist = GetScatterStep();
    uint layer = GetScatterLayer(rayLength, sampleDist);
    float start = layer * sampleDist;
    float remainderLength = layer > 0u && layer == _NumInScatterPoints - 1u ? 0.0f : rayLength - start;

    ScatterData remainder = (ScatterData)0;
    if(remainderLength <= 0.0f) {
        _RemainderScatter[index] = remainder;
        return;
    }

    float3 prefixExtinction = 0;
    if(layer > 0u) {
        Influences2D blend = GetLookupBlend(uv);
        [unroll]for(uint i = 0u; i < 4u; i++) {
            if(blend.corner[i] == 0.0f) continue;

            uint2 sampleCoord = blend.origin + uint2(i & 1u, i >> 1);
            prefixExtinction += mapData[GetTextureIndex(sampleCoord, layer)].extinction * blend.corner[i];
        }
    }

    float3 direction = normalize(viewVector);
    float invIsoScale = rcp(max((float)IsoLevel, 1.0f));
    uint sampleCount = max(_NumRemainderOpticalDepthPoints, 1u);
    float step = remainderLength / (float)sampleCount;

    AccumulateScatterSegment(_WorldSpaceCameraPos, direction, start, step,
        sampleCount, invIsoScale, prefixExtinction, remainder);
    
    _RemainderScatter[index] = remainder;
}
