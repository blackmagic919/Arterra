#pragma kernel Bake
#pragma multi_compile _ NO_EDITORLIGHTING

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

#include "Assets/Resources/Compute/Utility/GetIndex.hlsl"
#include "Assets/Resources/Compute/MapData/WSDensitySampler.hlsl"
#include "Assets/Resources/Compute/MapData/WSLightSampler.hlsl"
#include "Assets/Resources/Compute/Atmosphere/FrustumLightSpaceHelper.hlsl"
const static float StaticLightIntensity = 0.01f;

struct ScatterData{
    float3 inScatteredLight;
    float3 extinction;
};


RWStructuredBuffer<ScatterData> mapData;
StructuredBuffer<float3> sunLuminance;
StructuredBuffer<float> sunRayLengths;
uint screenHeight;
uint screenWidth;
uint sunHeight;
uint sunWidth;

float _AtmosphereRadius;
uint _NumInScatterPoints;
uint _NumOpticalDepthPoints;
uint _NumSunDepthPoints;

float3 GetRayDirectionWS(uint viewX, uint viewY) {
    float2 screenSize = float2(max(screenWidth - 1u, 1u), max(screenHeight - 1u, 1u));
    float2 screenUV = float2(viewX, viewY) / screenSize;
    float3 viewVectorCS = mul(unity_CameraInvProjection, float4(screenUV * 2.0 - 1.0, 0.0, -1.0)).xyz;
    return normalize(mul(unity_CameraToWorld, float4(viewVectorCS, 0.0)).xyz);
}

float3 SampleSunDepthColumn(uint sampleX, uint sampleY, float fsDepth){
    uint maxDepth = max(_NumSunDepthPoints, 1u) - 1u;
    float maxDepthF = max((float)_NumSunDepthPoints - 1.0f, 0.0f);

    uint sampleIndex = indexFromCoord2DManual(sampleX, sampleY, sunHeight);
    float sunRayLength = max(sunRayLengths[sampleIndex], 1e-6);
    float fsDepth01 = 1.0 - (fsDepth / sunRayLength);
    float zf = saturate(fsDepth01) * maxDepthF;
    float zFloor = floor(zf);
    uint z0 = min((uint)zFloor, maxDepth);
    uint z1 = min(z0 + 1u, maxDepth);
    float zBlend = zf - zFloor;

    uint index0 = indexFromCoordIrregular(sampleX, sampleY, z0, sunHeight, _NumSunDepthPoints);
    uint index1 = indexFromCoordIrregular(sampleX, sampleY, z1, sunHeight, _NumSunDepthPoints);
    return lerp(sunLuminance[index0], sunLuminance[index1], zBlend);
}

//Does a bilinear interp on a linear interped column: Thus performs trilinear interp
//We use custom trilinear blending here instead of the standard helper because depth is non normalizable between rays
float3 SampleSunOpticalDepth(float3 worldPos){
    float3 fsPos = WSPosToFSPos(worldPos);
    uint maxX = max(sunWidth, 1u) - 1u;
    uint maxY = max(sunHeight, 1u) - 1u;

    float2 fsScaled = saturate(fsPos.xy) * float2((float)sunWidth, (float)sunHeight) - 0.5;
    fsScaled = clamp(fsScaled, 0.0, float2((float)maxX, (float)maxY));
    float2 fsFloor = floor(fsScaled);
    uint x0 = min((uint)fsFloor.x, maxX);
    uint y0 = min((uint)fsFloor.y, maxY);
    uint x1 = min(x0 + 1u, maxX);
    uint y1 = min(y0 + 1u, maxY);
    float xBlend = fsScaled.x - fsFloor.x;
    float yBlend = fsScaled.y - fsFloor.y;

    // Blend in requested order: z first per XY column, then x, then y.
    float3 c00 = SampleSunDepthColumn(x0, y0, fsPos.z);
    float3 c10 = SampleSunDepthColumn(x1, y0, fsPos.z);
    float3 c01 = SampleSunDepthColumn(x0, y1, fsPos.z);
    float3 c11 = SampleSunDepthColumn(x1, y1, fsPos.z);

    float3 row0 = lerp(c00, c10, xBlend);
    float3 row1 = lerp(c01, c11, xBlend);
    return lerp(row0, row1, yBlend);
}

ScatterData ComputeScatterDensity(float3 inScatterPoint, float3 cameraDepth, OpticalInfo opticalInfo, float4 staticLight) {
    ScatterData scatterData = (ScatterData)0;

    float3 sunDepth = SampleSunOpticalDepth(inScatterPoint);

    float3 transmittance = exp(-(sunDepth + cameraDepth));
    float3 emissionColor = _MainLightColor.xyz;

    scatterData.inScatteredLight = emissionColor * opticalInfo.scatterCoeffs * transmittance * staticLight.w;
    scatterData.inScatteredLight += staticLight.xyz * exp(-cameraDepth) * StaticLightIntensity;
    scatterData.inScatteredLight *= opticalInfo.opticalDensity;
    scatterData.extinction = opticalInfo.extinctionCoeff * opticalInfo.opticalDensity;
    return scatterData;
}

void AccumulateOpticalAndStatic(float3 samplePoint, float isoScale, inout OpticalInfo opticalAccum, inout uint4 staticLightAccum) {
    OpticalInfo mapSample = SampleMapData(samplePoint);
    opticalAccum.opticalDensity += mapSample.opticalDensity / isoScale;
    opticalAccum.scatterCoeffs += mapSample.scatterCoeffs;
    opticalAccum.extinctionCoeff += mapSample.extinctionCoeff;

    uint light = SampleLightFast(samplePoint);
    staticLightAccum.x += (light & 0x3FF);
    staticLightAccum.y += (light >> 10 & 0x3FF);
    staticLightAccum.z += (light >> 20 & 0x3FF);
    staticLightAccum.w += (light >> 30 & 0x3);
}

void BuildDepthSampleAverages(
    float3 inScatterPoint,
    float3 direction,
    float sampleStep,
    float isoScale,
    out OpticalInfo opticalInfo,
    out float4 staticLight
) {
    uint sampleCount = max(_NumOpticalDepthPoints, 1u);
    float invSampleCount = 1.0f / (float)sampleCount;

    OpticalInfo opticalAccum = (OpticalInfo)0;
    uint4 staticLightAccum = 0;

    for(uint depthSample = 0u; depthSample < sampleCount; depthSample++) {
        float3 samplePoint = inScatterPoint + direction * (sampleStep * depthSample);
        AccumulateOpticalAndStatic(samplePoint, isoScale, opticalAccum, staticLightAccum);
    }

    opticalInfo = (OpticalInfo)0;
    opticalInfo.opticalDensity = opticalAccum.opticalDensity * invSampleCount;
    opticalInfo.scatterCoeffs = opticalAccum.scatterCoeffs * invSampleCount;
    opticalInfo.extinctionCoeff = opticalAccum.extinctionCoeff * invSampleCount;

    staticLight = float4(staticLightAccum) * invSampleCount;
    staticLight.xyz /= 1023.0f;
    staticLight.w = 1.0f - (staticLight.w / 3.0f);
}


const static uint numThreads = 8;
[numthreads(numThreads,numThreads,1)]
void Bake (uint3 id : SV_DispatchThreadID)
{
    uint viewX = id.x;
    uint viewY = id.y;

    if(viewX >= screenWidth || viewY >= screenHeight || id.z > 0)
        return;

    if(_NumInScatterPoints == 0u)
        return;

    uint sampleCount = max(_NumOpticalDepthPoints, 1u);
    float sampleDist = _AtmosphereRadius / max((float)(_NumInScatterPoints - 1u), 1.0f);
    float sampleStep = sampleDist / max((float)sampleCount - 1.0f, 1.0f);
    float3 direction = GetRayDirectionWS(viewX, viewY);
    float isoScale = max((float)IsoLevel, 1.0f);
    float3 cameraPos = _WorldSpaceCameraPos;

    ScatterData cumulative = (ScatterData)0;
    float3 cameraDepth = 0;

    for(uint depth = 0u; depth < _NumInScatterPoints; depth++) {
        float3 inScatterPoint = cameraPos + direction * (sampleDist * depth);
        OpticalInfo opticalInfo = (OpticalInfo)0;
        float4 staticLight = 0;
        BuildDepthSampleAverages(inScatterPoint, direction, sampleStep, isoScale, opticalInfo, staticLight);

        ScatterData curDensity = ComputeScatterDensity(inScatterPoint, cameraDepth, opticalInfo, staticLight);
        uint texelIndex = indexFromCoordIrregular(viewX, viewY, depth, screenHeight, _NumInScatterPoints);
        float3 cameraDepthStep = (opticalInfo.scatterCoeffs * opticalInfo.opticalDensity) * sampleDist;

        cumulative.inScatteredLight += curDensity.inScatteredLight * sampleDist;
        cumulative.extinction += curDensity.extinction * sampleDist;
        mapData[texelIndex] = cumulative;

        cameraDepth += cameraDepthStep;
    }
}