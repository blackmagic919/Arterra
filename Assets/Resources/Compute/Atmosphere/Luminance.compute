// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Bake
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

#include "Assets/Resources/Compute/Utility/GetIndex.hlsl"
#include "Assets/Resources/Compute/MapData/WSDensitySampler.hlsl"
#include "Assets/Resources/Compute/Atmosphere/FrustumLightSpaceHelper.hlsl"

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWStructuredBuffer<float3> luminance;
RWStructuredBuffer<float> sunRayLengths;

const static uint numThreads = 8;
uint sunHeight;
uint sunWidth;

float3 _LightDirection; //Global Variable

float _AtmosphereRadius;
uint _NumSunDepthPoints;
uint _NumLuminanceOpticalDepthPoints;

float2 raySphere(float3 s0, float sr, float3 r0, float3 rd) {
    float a = dot(rd, rd);
    float3 s0_r0 = r0 - s0;
    float b = 2.0 * dot(rd, s0_r0);
    float c = dot(s0_r0, s0_r0) - (sr * sr);
    float disc = b * b - 4.0 * a * c;

    if (disc < 0.0) {
        return float2(-1.0, -1.0);
    } else {
        float t1 = max((-b - sqrt(disc)) / (2.0 * a), 0);
        float t2 = max((-b + sqrt(disc)) / (2.0 * a), 0);
        return float2(t1, t2 - t1);
    }
}

[numthreads(numThreads,numThreads,1)]
void Bake (uint3 id : SV_DispatchThreadID)
{
    uint viewX = id.x;
    uint viewY = id.y;

    if(viewX >= sunWidth || viewY >= sunHeight || id.z > 0)
        return;

    float2 fsUV = (float2(viewX, viewY) + 0.5f) / float2(max(sunWidth, 1u), max(sunHeight, 1u));
    float3 frustumOriginWS = FSUVToWSPos(fsUV);
    uint pixelIndex = indexFromCoord2DManual(viewX, viewY, sunHeight);

    float3 lightDir = normalize(_LightDirection);
    float sunRayLength = raySphere(_WorldSpaceCameraPos, _AtmosphereRadius, frustumOriginWS, lightDir).y;
    sunRayLength = max(sunRayLength, 0.0f);
    sunRayLengths[pixelIndex] = sunRayLength;

    float3 rayStartWS = frustumOriginWS + lightDir * sunRayLength;
    float3 rayDir = -lightDir;


    float segments = max((float)(_NumSunDepthPoints - 1u), 1.0f);
    float stepSize = sunRayLength / segments;

    uint opticalSampleCount = max(_NumLuminanceOpticalDepthPoints, 1u);
    float invOpticalSampleCount = 1.0f / (float)opticalSampleCount;
    float isoScale = max((float)IsoLevel, 1.0f);
    float3 cumulativeDepth = 0;

    for(uint depth = 0; depth < _NumSunDepthPoints; depth++){
        uint texelIndex = indexFromCoordIrregular(viewX, viewY, depth, sunHeight, _NumSunDepthPoints);
        luminance[texelIndex] = cumulativeDepth;

        if(depth + 1u >= _NumSunDepthPoints)
            break;

        float3 segmentOpticalAccum = 0;
        for(uint opticalSample = 0u; opticalSample < opticalSampleCount; opticalSample++) {
            float intervalT = ((float)opticalSample + 0.5f) * invOpticalSampleCount;
            float3 samplePointWS = rayStartWS + rayDir * (stepSize * ((float)depth + intervalT));
            OpticalDepth sampleData = SampleOpticalDepth(samplePointWS);
            segmentOpticalAccum += sampleData.scatterCoeffs * (sampleData.opticalDensity / isoScale);
        }

        float3 segmentOpticalAverage = segmentOpticalAccum * invOpticalSampleCount;
        cumulativeDepth += segmentOpticalAverage * stepSize;
    }
    
}
