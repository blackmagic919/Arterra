// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Bake
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

#include "Assets/Resources/Compute/Utility/GetIndex.hlsl"
#include "Assets/Resources/Compute/MapData/WSDensitySampler.hlsl"
#include "Assets/Resources/Compute/Atmosphere/FrustumLightSpaceHelper.hlsl"

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWStructuredBuffer<float3> luminance;
RWStructuredBuffer<float> sunRayLengths;

const static uint numThreads = 8;
uint screenHeight;
uint screenWidth;

float3 _LightDirection; //Global Variable

float _AtmosphereRadius;
uint _NumInScatterPoints;

float2 raySphere(float3 s0, float sr, float3 r0, float3 rd) {
    float a = dot(rd, rd);
    float3 s0_r0 = r0 - s0;
    float b = 2.0 * dot(rd, s0_r0);
    float c = dot(s0_r0, s0_r0) - (sr * sr);
    float disc = b * b - 4.0 * a * c;

    if (disc < 0.0) {
        return float2(-1.0, -1.0);
    } else {
        float t1 = max((-b - sqrt(disc)) / (2.0 * a), 0);
        float t2 = max((-b + sqrt(disc)) / (2.0 * a), 0);
        return float2(t1, t2 - t1);
    }
}

[numthreads(numThreads,numThreads,1)]
void Bake (uint3 id : SV_DispatchThreadID)
{
    uint viewX = id.x;
    uint viewY = id.y;

    if(viewX >= screenWidth || viewY >= screenHeight || id.z > 0)
        return;

    float2 fsUV = (float2(viewX, viewY) + 0.5f) / float2(max(screenWidth, 1u), max(screenHeight, 1u));
    float3 frustumOriginWS = FSUVToWSPos(fsUV);
    uint pixelIndex = indexFromCoord2DManual(viewX, viewY, screenHeight);

    float3 lightDir = normalize(_LightDirection);
    float sunRayLength = raySphere(_WorldSpaceCameraPos, _AtmosphereRadius, frustumOriginWS, lightDir).y;
    sunRayLength = max(sunRayLength, 0.0f);
    sunRayLengths[pixelIndex] = sunRayLength;

    float3 rayStartWS = frustumOriginWS + lightDir * sunRayLength;
    float3 rayDir = -lightDir;


    float layers = max((float)(_NumInScatterPoints - 1), 1.0f);
    float stepSize = sunRayLength / layers;

    float isoScale = max((float)IsoLevel, 1.0f);
    float3 cumulativeDepth = 0;
    float3 samplePointWS = rayStartWS;
    float3 currentSample = 0;

    if(_NumInScatterPoints > 1u) {
        OpticalDepth sampleData = SampleOpticalDepth(samplePointWS);
        currentSample = sampleData.scatterCoeffs * (sampleData.opticalDensity / isoScale);
    }

    for(uint depth = 0; depth < _NumInScatterPoints; depth++){
        uint texelIndex = indexFromCoordIrregular(viewX, viewY, depth, screenHeight, _NumInScatterPoints);
        luminance[texelIndex] = cumulativeDepth;

        if(depth + 1u >= _NumInScatterPoints)
            break;

        samplePointWS += rayDir * stepSize;
        OpticalDepth nextSampleData = SampleOpticalDepth(samplePointWS);
        float3 nextSample = nextSampleData.scatterCoeffs * (nextSampleData.opticalDensity / isoScale);

        cumulativeDepth += (currentSample + nextSample) * (0.5f * stepSize);
        currentSample = nextSample;
    }
    
}
